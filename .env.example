APP_ENV=development
APP_MODE=RESEARCH
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/stream
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=4
RETRY_BASE_SECONDS=0.4
SCAN_INTERVAL_SECONDS=60
MAX_DATA_AGE_SECONDS=75
MIN_SPOT_QUOTE_VOLUME_USDT=10000000
MIN_FUTURES_QUOTE_VOLUME_USDT=10000000
MAX_SPOT_SPREAD_BPS=8
MAX_FUTURES_SPREAD_BPS=8
TRADE_NOTIONAL_USDT=1000
SPOT_TAKER_FEE_RATE=0.001
FUTURES_TAKER_FEE_RATE=0.0005
MAX_DEPTH_SYMBOLS_PER_CYCLE=30
MAX_HISTORY_SYMBOLS_PER_CYCLE=30
ORDERBOOK_LIMIT=20
DEPTH_LEVELS=20
HISTORY_LIMIT=100
MAX_CONCURRENT_REQUESTS=8
MIN_NET_EDGE_USDT=0
BASIS_RISK_HAIRCUT=0.25
SCORE_WEIGHT_NET_EDGE=0.25
SCORE_WEIGHT_FUNDING_CONSISTENCY=0.15
SCORE_WEIGHT_LIQUIDITY=0.15
SCORE_WEIGHT_SPREAD=0.10
SCORE_WEIGHT_SLIPPAGE=0.10
SCORE_WEIGHT_BASIS=0.10
SCORE_WEIGHT_FRESHNESS=0.10
SCORE_WEIGHT_FUNDING_VOLATILITY=0.05
SCORE_WEIGHT_HEDGE_PRECISION=0.05
SCORE_WEIGHT_RESIDUAL_EXPOSURE=0.05
RANKING_MAX_SPREAD_BPS=10
RANKING_MAX_SLIPPAGE_BPS=30
RANKING_MAX_BASIS_BPS=100
DATABASE_PATH=data/market_data.sqlite3
RETENTION_DAYS=90
WEBSOCKET_ENABLED=false
LIVE_VALIDATION_ENABLED=false
VALIDATION_INTERVAL_SECONDS=300
MAX_CLOCK_DRIFT_MS=5000
MAX_VALIDATION_MESSAGE_AGE_MS=15000
WEBSOCKET_PROBE_TIMEOUT_SECONDS=5
MAX_RECONNECT_ATTEMPTS=10
MAX_RECOVERY_DURATION_MS=60000
MAX_MESSAGE_PROCESSING_LATENCY_MS=100
MAX_STALE_SYMBOLS=5
FUNDING_HISTORY_MAX_PAGES=5
MAX_HEDGE_MISMATCH=0.005
MAX_CLOCK_SKEW_MS=5000
WEBSOCKET_STREAMS_PER_CONNECTION=400
OBSERVATION_MODE=false
LIVE_TRADING_ENABLED=false
